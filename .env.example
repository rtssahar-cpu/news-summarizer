# ローカル開発用の環境変数サンプル。
# コピーして .env を作成すること。
#   cp .env.example .env
#
# .env は .gitignore 対象（コミットしないこと）。

POSTGRES_DB=newssummarizer
POSTGRES_USER=newssummarizer
POSTGRES_PASSWORD=newssummarizer

# 日次処理（python -m app.frameworks.daily_job）で記事の分析に使う Anthropic の API キー。
# API の利用料は Console でクレジットを購入しておく必要がある
ANTHROPIC_API_KEY=
