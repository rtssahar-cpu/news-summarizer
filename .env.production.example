# 本番環境用の環境変数サンプル。
# コピーして .env.production を作成し、実際の値を設定すること。
#   cp .env.production.example .env.production
#
# .env.production はシークレットを含むため .gitignore 対象（コミットしないこと）。

# --- PostgreSQL ---
POSTGRES_DB=newssummarizer
POSTGRES_USER=newssummarizer
POSTGRES_PASSWORD=CHANGE_ME

# --- Django ---
# 複数ホストを許可する場合はカンマ区切り（例: example.com,www.example.com）
DJANGO_ALLOWED_HOSTS=CHANGE_ME
