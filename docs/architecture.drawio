<mxfile host="app.diagrams.net">
  <diagram id="network" name="ネットワーク構成">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 枠（Azure・リソースグループ・環境・GitHub） -->
        <mxCell id="sub" value="Azure サブスクリプション（Azure subscription 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#0078D4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="780" height="790" as="geometry" />
        </mxCell>
        <mxCell id="rg" value="リソースグループ news-summarizer-rg（japaneast）&lt;br&gt;Terraform で管理（infra/）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;dashed=0;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="520" height="560" as="geometry" />
        </mxCell>
        <mxCell id="env" value="Container Apps 環境 news-summarizer-env&lt;br&gt;（VNet なし。外向きの通信はインターネット経由）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#5B9BD5;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="200" width="300" height="270" as="geometry" />
        </mxCell>
        <mxCell id="devrg" value="リソースグループ dev-vm-rg（Terraform の管理外）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="670" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="gh" value="GitHub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#24292F;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Azure 内のリソース -->
        <mxCell id="swa" value="Static Web Apps（フロントエンド）&lt;br&gt;※未着手" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B9BD5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="115" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;Container App&lt;/b&gt;&lt;br&gt;news-summarizer-backend&lt;br&gt;FastAPI・外部 ingress（HTTPS）・0〜1 レプリカ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="360" y="250" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="job" value="&lt;b&gt;Container Apps Job&lt;/b&gt;（日次処理）&lt;br&gt;毎朝 6:00 JST・※作成予定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="370" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="law" value="Log Analytics&lt;br&gt;news-summarizer-env-logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F0E0;strokeColor=#5A9E4B;" vertex="1" parent="1">
          <mxGeometry x="670" y="240" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st" value="ストレージアカウント&lt;br&gt;stnewssumtfstate&lt;br&gt;（Terraform の state）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="670" y="530" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="devvm" value="&lt;b&gt;dev-vm&lt;/b&gt;（開発用 VM）&lt;br&gt;Terraform・Claude Code&lt;br&gt;マネージド ID：news-summarizer-rg の共同作成者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;" vertex="1" parent="1">
          <mxGeometry x="350" y="715" width="290" height="70" as="geometry" />
        </mxCell>

        <!-- Azure 外 -->
        <mxCell id="user" value="利用者（ブラウザ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gha" value="GitHub Actions（CI/CD）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#24292F;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ghcr" value="ghcr.io&lt;br&gt;（コンテナイメージ・公開）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#24292F;" vertex="1" parent="1">
          <mxGeometry x="60" y="515" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="neon" value="Neon（PostgreSQL）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="190" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="anth" value="Anthropic API（Claude）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1130" y="340" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="src" value="取得元サイト&lt;br&gt;防衛省（RSS・PDF）・防衛装備 7 社" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1130" y="450" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;実線：稼働中&lt;br&gt;破線：予定・未作成&lt;br&gt;通信はすべてインターネット経由（TLS）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#999999;fillColor=#FFFFFF;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1130" y="640" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- 通信 -->
        <mxCell id="e-user-swa" value="HTTPS（画面）" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;" edge="1" parent="1" source="user" target="swa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-user-app" value="HTTPS（API 呼び出し）" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;" edge="1" parent="1" source="user" target="app">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="285" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-app-neon" value="PostgreSQL（TLS）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="app" target="neon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="285" />
              <mxPoint x="1000" y="230" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-job-neon" value="PostgreSQL（TLS）" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;" edge="1" parent="1" source="job" target="neon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="390" />
              <mxPoint x="1030" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-job-anth" value="HTTPS（分類・要約）" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;" edge="1" parent="1" source="job" target="anth">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1060" y="410" />
              <mxPoint x="1060" y="368" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-job-src" value="HTTPS（記事の取得）" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;" edge="1" parent="1" source="job" target="src">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1060" y="425" />
              <mxPoint x="1060" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-env-law" value="ログ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="env" target="law">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gha-ghcr" value="push" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="gha" target="ghcr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ghcr-env" value="イメージの pull" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ghcr" target="env">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="540" />
              <mxPoint x="280" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-gha-app" value="OIDC で認証し&lt;br&gt;イメージを更新" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="gha" target="env">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="465" />
              <mxPoint x="260" y="230" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-devvm-st" value="state の読み書き" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="devvm" target="st">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="745" y="750" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-devvm-rg" value="Terraform（plan・apply）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="devvm" target="rg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="495" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
